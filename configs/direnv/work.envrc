# ~/work/.envrc — managed by ~/dotfiles (configs/direnv/work.envrc)
#
# Applies to every repo cloned under ~/work/: direnv walks up from the
# current directory looking for an .envrc and stops at the first one it
# finds, so any repo here picks this up automatically as long as it doesn't
# ship its own .envrc.
#
# GITHUB_TOKEN is what those repos' .npmrc files expect for authenticating
# against npm.pkg.github.com (private @px-center packages), e.g.:
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
#
# Pulled fresh from `gh auth token` on every `cd` instead of a static
# secret, so it's never stored on disk and always matches whatever account
# `gh` is currently logged into. Requires the `read:packages` scope — check
# with `gh auth status` and add it with `gh auth refresh -s read:packages`
# if it's missing.
export GITHUB_TOKEN="$(gh auth token)"
