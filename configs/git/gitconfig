	email = hello@henrique.zip
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDGIa977/ftf7GB5CJq0K/nP9aDgdKOPJeHMwjY0GHYN

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	features = dracula

[include]
	path = ~/dotfiles/configs/git/dracula-delta.gitconfig

# `gitdir:` matches case-sensitively even on a case-insensitive filesystem,
# so the pattern has to be `/i` or spelled exactly like the directory (~/Work).
[includeIf "gitdir/i:~/work/"]
	path = ~/dotfiles/configs/git/work.gitconfig

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true
