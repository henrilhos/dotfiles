[user]
	name = Henrique de Castilhos
	email = hello@henrique.zip

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	features = dracula

[include]
	path = ~/dotfiles/configs/git/dracula-delta.gitconfig

# `gitdir:` matches case-sensitively even on a case-insensitive filesystem,
# so the pattern has to be `/i` or spelled exactly like the directory (~/Work).
[includeIf "gitdir/i:~/work/"]
	path = ~/dotfiles/configs/git/work.gitconfig

# Commit signing with a Secretive SSH key, off by default. Setup in
# docs/secretive.md.
# [user]
# 	signingkey = key::CHANGEME
# [gpg]
# 	format = ssh
# [commit]
# 	gpgsign = true

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
