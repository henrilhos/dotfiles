[user]
	name = CHANGEME
	email = CHANGEME

[init]
	defaultBranch = main

[pull]
	rebase = false

[core]
	editor = code --wait
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	# Ayu from configs/bat/themes, registered by `bat cache --build`.
	syntax-theme = ayu-dark

# `gitdir:` matches case-sensitively even on a case-insensitive filesystem,
# so the pattern has to be `/i` or spelled exactly like the directory (~/Work).
[includeIf "gitdir/i:~/work/"]
	path = ~/dotfiles/configs/git/work.gitconfig

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
