[init]
	defaultBranch = main

[pull]
	rebase = false

# Drop origin/* refs for branches deleted on the remote (e.g. after a PR merge).
[fetch]
	prune = true

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	# Ayu from configs/bat/themes, registered by `bat cache --build`.
	syntax-theme = ayu-dark

# `gitdir:` matches case-sensitively even on a case-insensitive filesystem,
# so the pattern has to be `/i` or spelled exactly like the directory (~/Work).
[includeIf "gitdir/i:~/work/"]
	path = ~/dotfiles/configs/git/work.gitconfig

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
