# ~/.config/ghostty/config — managed by ~/dotfiles (configs/ghostty/config)
# Full option reference: https://ghostty.org/docs/config/reference

# Repeated `font-family` entries form a fallback chain: Ghostty renders each
# glyph with the first font in the list that has it. Rec Mono Linear (the
# "Linear" style of Recursive Code) covers normal text; Symbols Nerd Font
# Mono fills in the icon glyphs (used by starship, LazyVim's
# bufferline/statusline, etc.) that Recursive doesn't have. Confirmed via
# `ghostty +list-fonts`; Recursive also ships Casual/Semicasual/Duotone
# styles if you want a different feel later.
font-family = "Rec Mono Linear"
font-family = "Symbols Nerd Font Mono"

font-size = 14

# Both Option keys send Alt/Meta (so zsh's `\eX` keybinds like sesh's
# Alt-s work). Trade-off: Option no longer composes accented characters
# (Option-e, Option-c, ...) in the terminal.
# https://ghostty.org/docs/config/reference#macos-option-as-alt
macos-option-as-alt = true

# Dracula PRO (dark) / Alucard (light), switching automatically with the
# macOS Appearance setting. Kept out of this repo as a git submodule
# (submodules/dracula-pro-ghostty) since it's paid/private content — each
# side of `theme` just points at a palette file from there.
#
# Unlike `config-file` above, `theme` doesn't expand `~` (confirmed with
# `ghostty +validate-config`), so this needs an absolute path.
theme = dark:/Users/henrilhos/dotfiles/submodules/dracula-pro-ghostty/pro,light:/Users/henrilhos/dotfiles/submodules/dracula-pro-ghostty/alucard
