Include ~/.colima/ssh_config

# ~/.ssh/config — managed by ~/dotfiles (configs/ssh/config)
#
# Route every SSH connection through Secretive's agent instead of
# ~/.ssh/id_*, so keys live in the Mac's Secure Enclave (Touch ID on use,
# never exportable) rather than as files on disk. Setup in
# docs/secretive.md.

Host *
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

# Reach GitHub over HTTPS rather than port 22, which corporate networks
# tend to block. ssh.github.com:443 speaks the SSH protocol and is
# GitHub's own supported route, so this is safe everywhere, not just on
# a restricted network.
Host github.com
  Hostname ssh.github.com
  Port 443
  User git
