Include ~/.colima/ssh_config

# ~/.ssh/config — managed by ~/dotfiles (configs/ssh/config)
#
# Route every SSH connection through 1Password's SSH agent instead of
# ~/.ssh/id_*, so keys stay in 1Password's vault (biometric/Touch ID
# unlock) rather than as unencrypted files on disk.
#
# Requires enabling it once inside the 1Password app itself (no CLI/
# nix-darwin equivalent — it's an app-internal toggle):
#   1Password > Settings > Developer > "Use the SSH agent"

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# cebolinha dual-boots Bazzite and Windows, each its own Tailscale node
# with its own host key. Separate hostnames keep known_hosts entries apart.
# Only one OS is up at a time. MagicDNS resolves the short names, so the
# tailnet domain stays out of this public repo.
Host cebolinha-linux cebolinha-win
  User henrilhos

# Reach GitHub over HTTPS rather than port 22, which corporate networks
# tend to block. ssh.github.com:443 speaks the SSH protocol and is
# GitHub's own supported route, so this is safe everywhere, not just on
# a restricted network.
Host github.com
  Hostname ssh.github.com
  Port 443
  User git
